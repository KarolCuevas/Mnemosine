DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=mnemosine
DB_USER=mnemosine_app
# Debe coincidir con MYSQL_PASSWORD en el .env de la raíz.
DB_PASSWORD=CAMBIAR_clave_app_local

# Seguridad (Fase 2). Genera una clave propia:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_clave_aleatoria_hex_64
# Sesiones: expiración deslizante y límite absoluto (días).
SESSION_SLIDING_DAYS=7
SESSION_ABSOLUTE_DAYS=30
# Obligatorio en producción tras HTTPS: SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5

# Cargas (Fase 3, D3). 50 MB por archivo; 5 GB de cuota por cuenta.
MAX_UPLOAD_BYTES=52428800
MAX_USER_QUOTA_BYTES=5368709120
# Por defecto, <repo>/storage. Debe existir y no publicarse como directorio estático.
# STORAGE_ROOT=C:/ruta/absoluta/storage

# Catálogo público (no requiere API key). Contacto real del proyecto.
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_CONTACT=czmprojects@gmail.com
CATALOG_CACHE_SECONDS=3600
CATALOG_RECORD_TTL_DAYS=30

# Google Drive personal. Rutas absolutas del servidor a archivos excluidos de Git.
# La clave de Picker es pública en el navegador, pero debe estar restringida en Google.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_PROJECT_ID=
GOOGLE_PROJECT_NUMBER=
GOOGLE_APP_ORIGIN=http://127.0.0.1:5173
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_TOKEN_KEYS_FILE=
GOOGLE_PICKER_KEY_FILE=
